# Mindora Doctor Dashboard Environment Configuration
# In development, leave VITE_API_BASE_URL empty to use the Vite dev server proxy configured in vite.config.ts (which forwards /api to http://localhost:5222)
# In standalone/production, set this to the backend API base URL (e.g. http://localhost:5222 or https://api.mindora.com)
VITE_API_BASE_URL=
